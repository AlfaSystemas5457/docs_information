<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_vehicle_document_list" model="ir.ui.view">
        <field name="name">fleet.document.list</field>
        <field name="model">fleet.vehicle.document</field>
        <field name="arch" type="xml">
            <list string="Documentos de Vehiculos" duplicate="0">
                <field name="name" />
                <field name="vehicle_id" />
                <field name="document_type" />
                <field name="issue_date" optional="show" />
                <field name="expiration_date" />
            </list>
        </field>
    </record>

    <record id="view_vehicle_document_search" model="ir.ui.view">
        <field name="name">fleet.vehicle.document.search</field>
        <field name="model">fleet.vehicle.document</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="vehicle_id" />
                <field name="document_type" />

                <filter name="has_file" string="Con Archivo" domain="[('file', '!=', False)]" />
                <filter name="without_file" string="Sin Archivo" domain="[('file', '=', False)]" />

                <group expand="1" string="Agrupar por">
                    <filter name="group_by_document_type" string="Tipo de documento"
                        context="{'group_by': 'document_type'}" />
                    <filter name="group_by_vehicle_id" string="Vehiculo"
                        context="{'group_by': 'vehicle_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="view_vehicle_document_kanban" model="ir.ui.view">
        <field name="name">fleet.document.kanban</field>
        <field name="model">fleet.vehicle.document</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name" />
                <field name="vehicle_id" />
                <field name="document_type" />
                <field name="issue_date" />
                <field name="expiration_date" />
                <field name="file_extension" />
                <templates>
                    <t t-name="card" class="flex-row">
                        <main>
                            <div t-attf-class="oe_kanban_global_click oe_kanban_content row g-0">
                                <div class="col-3">
                                    <img
                                        t-att-src="'/docs_information/static/icons/file_' + (record.file_extension.raw_value || 'unknown') + '.svg'"
                                        alt="Archivo adjunto" style="width: 100%;" />
                                </div>
                                <div class="col-9">
                                    <strong>
                                        <field name="name" />
                                    </strong>
                                    <div>
                                        <field name="document_type" />
                                    </div>
                                    <div invisible="not issue_date and not expiration_date"> 📅 <field
                                            name="issue_date" /> <span
                                            invisible="not issue_date or not expiration_date">-</span> <field
                                            name="expiration_date" />
                                    </div>
                                </div>
                                <footer>
                                    <field name="vehicle_id" />
                                </footer>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_vehicle_document_form" model="ir.ui.view">
        <field name="name">fleet.document.form</field>
        <field name="model">fleet.vehicle.document</field>
        <field name="arch" type="xml">
            <form string="Documento del vehiculo">
                <sheet string="Documentos">
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nombre del documento" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="vehicle_id" />
                            <field name="document_type" />
                        </group>
                        <group>
                            <field name="issue_date" />
                            <field name="expiration_date" />
                        </group>
                    </group>

                    <notebook>
                        <page string="Archivo">
                            <group invisible="1">
                                <field name="file_extension" />
                            </group>
                            <group>
                                <div>
                                    <field name="file"
                                        filename="filename"
                                        widget="file_viewer" />
                                </div>
                            </group>
                        </page>
                        <page name="notes" string="Notas">
                            <field name="notes" />
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="action_vehicle_document" model="ir.actions.act_window">
        <field name="name">Documentos de Vehiculos</field>
        <field name="res_model">fleet.vehicle.document</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="groups_id"
            eval="[(4, ref('docs_information.group_documents_access_all'))]" />
        <field name="help" type="html">
            <div class="o_view_nocontent">
                <div class="o_nocontent_help">
                    <p class="o_view_nocontent_smiling_face">
                        ¡Registra los documentos de los vehiculos aquí!
                    </p>
                </div>
            </div>
        </field>
    </record>
</odoo>